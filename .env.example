# === Auth (single admin, lihat PRD diskusi - bukan multi-provider OAuth) ===
# Generate: node scripts/hash-password.mjs "password-kamu"
# HARUS base64 (bukan hash bcrypt mentah) - value mentah berisi "$" yang kena bug
# ekspansi variabel Next.js pada .env, bikin login selalu gagal. Jangan tempel hash
# bcrypt ($2b$10$...) langsung di sini.
ADMIN_PASSWORD_HASH_B64=
# String acak panjang, mis: openssl rand -base64 32
SESSION_SECRET=

# === Database ===
DATABASE_PATH=./data/kontenpilot.db

# === App URL (dipakai utk bangun redirect_uri OAuth yg PERSIS - jangan andalkan header
# Host dari request krn di belakang nginx reverse proxy bisa berbeda) ===
APP_URL=https://aimarketing.pelangihomestay.com

# === AI (OpenAI - subtitle/caption/hashtag generation via Whisper + chat model) ===
OPENAI_API_KEY=

# === Cloudinary (render video final: splice klip terpilih + bakar subtitle SRT) ===
# Ambil dari dashboard Cloudinary (Cloud Name/API Key/API Secret di halaman utama).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# === Storage (S3-compatible, rekomendasi Cloudflare R2 - biaya egress lebih murah) ===
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=

# === Meta Graph API (Instagram + Facebook, native - mode developer/tester akun sendiri) ===
# Lihat PRD diskusi: TIDAK perlu App Review krn cuma akun brand milik sendiri sbg tester.
# CATATAN: IG User ID / Page ID / access token per-akun disimpan di DB (tabel
# social_accounts, kolom platform_account_id + access_token) - BEDA per brand, jadi
# BUKAN env var di sini. Ini cuma kredensial App-nya (dipakai bareng semua brand).
META_APP_ID=
META_APP_SECRET=

# === YouTube Data API (native, OAuth "testing" status) ===
# Authorized redirect URI di Google Cloud Console HARUS persis:
# {APP_URL}/api/auth/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# === Buffer API (dipakai KHUSUS utk TikTok - lihat PRD diskusi kenapa bukan API TikTok langsung) ===
BUFFER_ACCESS_TOKEN=

# === Telegram (notifikasi tiap kali auto-publish - BUKAN WhatsApp, lihat PRD diskusi) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Pexels + Pixabay (stok video B-roll "pendamping" - OPSIONAL, video tetap jalan
# tanpa ini kalau kosong, cuma tanpa B-roll). Pexels diutamakan, Pixabay jadi cadangan
# kalau Pexels tidak ketemu hasil - daftar gratis di pexels.com/api & pixabay.com/api ===
PEXELS_API_KEY=
PIXABAY_API_KEY=

# === Agustap Studio Content Intelligence & Faceless Extension (PRD §8) - default OFF.
# Brand lain SELALU 0% terpengaruh apa pun nilai flag ini (guard §7,
# src/lib/agustap/featureFlag.ts). Set "true" HANYA di environment development saat
# Phase 2+ mulai diuji. ===
AGUSTAP_CONTENT_INTELLIGENCE_ENABLED=false
