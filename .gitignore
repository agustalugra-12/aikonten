# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Lottie render tooling (2026-08-11, lihat scripts/lottie/) - venv Python lokal,
# di-install ulang per-mesin (bukan dependency runtime app), bukan utk dicommit.
/.venv-lottie/
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# database lokal (SQLite - data nyata, jangan pernah masuk repo)
/data/*.db
/data/*.db-*
# 2026-08-13 - backup migrasi Drizzle (kontenpilot.db.bak-pre-NNNN) TIDAK tertangkap pola
# di atas (".db.bak-..." beda dari ".db-...", ada titik bukan strip sebelum "bak") -
# ditemukan lewat git status nyata, belasan file 2-4MB nyaris ke-commit tanpa sengaja.
/data/*.bak-*

# typescript
*.tsbuildinfo
next-env.d.ts
