[Unit]
Description=Jadwal rekonsiliasi pembayaran KontenPilot SaaS (tiap 15 menit)

# Tiap 15 menit = sama dengan AMBANG_MENGGANTUNG_MS (lib/billing/statusPembayaran.ts), jadi
# tagihan pending paling lama ~30 menit sebelum terlapor ke Telegram. Endpoint no-op (dan tak
# kirim notif) kalau tak ada tagihan pending.

[Timer]
OnBootSec=5min
OnUnitActiveSec=15min
Persistent=false

[Install]
WantedBy=timers.target
