[Unit]
Description=HyperFrames Render Service (worker 4-core)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/hyperframes-render
EnvironmentFile=/root/hyperframes-render/service.env
Environment=PATH=/root/.nvm/versions/node/v24.22.2/bin:/usr/local/bin:/usr/bin:/bin
Environment=PUPPETEER_CACHE_DIR=/root/.cache/puppeteer
ExecStart=/root/.nvm/versions/node/v24.22.2/bin/node /root/hyperframes-render/server.mjs
Restart=on-failure
RestartSec=3
MemoryMax=5G

[Install]
WantedBy=multi-user.target
